##ALT=<ID=DEL,Description="Deletion relative to the reference">
##INFO=<ID=VARTYPE,Number=1,Type=String,Description="iGene custom-field variant category (Sequence Variant / Intragenic Copy Number Variant / Multigenic Copy Number Variant / Structural Variant)">
##INFO=<ID=GENE,Number=1,Type=String,Description="Gene studied [ID] (LOINC 48018-6)">
##INFO=<ID=CYTOBAND,Number=1,Type=String,Description="Cytogenetic (chromosome) location (LOINC 48001-2)">
##INFO=<ID=HGVSC,Number=1,Type=String,Description="Transcript reference sequence and DNA change, c.HGVS (LOINC 51958-7; 48004-6)">
##INFO=<ID=HGVSP,Number=1,Type=String,Description="Amino acid change, p.HGVS (LOINC 48005-3)">
##INFO=<ID=HGVSG,Number=1,Type=String,Description="Genomic DNA change, g.HGVS, exactly as given in the source Genomic_coordinates field (LOINC 81290-9)">
##INFO=<ID=CLASS,Number=1,Type=String,Description="Genetic variation clinical significance [Imp] (LOINC 53037-8)">
##INFO=<ID=CLASSEVIDENCE,Number=1,Type=String,Description="Free-text summary of evidence supporting the classification decision (spaces replaced with underscores)">
##INFO=<ID=INHERITANCE,Number=1,Type=String,Description="Inheritance of the variant: Maternal/Paternal/De_novo/Unknown">
##INFO=<ID=SVTYPE,Number=1,Type=String,Description="Type of structural variant">
##INFO=<ID=END,Number=1,Type=Integer,Description="End position of the variant described in this record">
##INFO=<ID=SVLEN,Number=1,Type=Integer,Description="Difference in length between REF and ALT alleles">
##INFO=<ID=IMPRECISE,Number=0,Type=Flag,Description="Reported breakpoints are the minimum affected extent, as given in the source Example value">
##FORMAT=<ID=GT,Number=1,Type=String,Description="Genotype">
##FORMAT=<ID=VAF,Number=1,Type=Float,Description="Sample variant allelic frequency [NFr] (LOINC 81258-6), converted from the source percentage Example value">
##FORMAT=<ID=ZYG,Number=1,Type=String,Description="Allelic state / copy-number state (LOINC 53034-5), spaces replaced with underscores">
##igene_QualityScore=PASS
##igene_HeadlineResult=Reportable_variant(s)_detected
##igene_PanelCoverage=98.99%_at_138x
##igene_ReflexTest=No_confirmation_required
##igene_Note_LossOfHeterozygosity=LOH1/LOH2 custom fields only carry Gene(s) and LOH State (Example: "Significant LOH"); no genomic coordinate Example is provided in the source workbook, so no LOH record could be placed in this VCF.
